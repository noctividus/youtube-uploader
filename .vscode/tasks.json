{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Uploader: Build and publish GitHub release",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\publish_release.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Uploader: Install GitHub CLI",
      "type": "process",
      "command": "winget",
      "args": ["install", "--id", "GitHub.cli", "--exact", "--source", "winget"],
      "problemMatcher": []
    },
    {
      "label": "Uploader: Sign in to GitHub",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\publish_release.py", "--login"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
    },
    {
      "label": "Uploader: Build Windows release",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\build.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Uploader: Restart testing app",
      "dependsOrder": "sequence",
      "dependsOn": ["Uploader: Stop testing app", "Uploader: Run for testing"],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 2 }
    },
    {
      "label": "Uploader: Run for testing",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\dev_app.py", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Uploader: Stop testing app",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\scripts\\dev_app.py", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
